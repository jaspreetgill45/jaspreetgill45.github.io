---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import WriteupShell from '../../layouts/WriteupShell.astro';

// One page per writeup. Drafts are only built while you work locally.
export async function getStaticPaths() {
	const writeups = await getCollection('writeups', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
	return writeups.map((w) => ({ params: { slug: w.id }, props: w }));
}
type Props = CollectionEntry<'writeups'>;

const w = Astro.props;
const { Content } = await render(w);
const { title, description, date, updated, platform, category, difficulty, tools, draft } = w.data;

const fmt = (d: Date) =>
	d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const facts = [
	platform && ['Platform', platform],
	category && ['Category', category],
	difficulty && ['Difficulty', difficulty],
	tools.length > 0 && ['Tools', tools.join(', ')],
].filter(Boolean) as [string, string][];
---
<WriteupShell title={`${title} — Jaspreet Singh`} description={description}>
	<article>
		<a class="w-back" href="/writeups/">All writeups</a>
		<h1 class="w-h1">{title}</h1>
		<p class="w-date">
			<time datetime={date.toISOString()}>{fmt(date)}</time>
			{updated && <span>, updated {fmt(updated)}</span>}
			{draft && <em class="w-draft">Draft, not published</em>}
		</p>
		<p class="w-lead">{description}</p>
		{facts.length > 0 && (
			<dl class="w-facts">
				{facts.map(([k, v]) => (
					<div><dt>{k}</dt><dd>{v}</dd></div>
				))}
			</dl>
		)}
		<div class="prose">
			<Content />
		</div>
	</article>
</WriteupShell>

<style>
	.w-back { font-size: 14px; color: var(--bone-dim); text-decoration: none; }
	.w-back:hover { color: var(--bone); }
	.w-h1 {
		margin: 22px 0 12px; font-weight: 400; font-size: clamp(32px, 5vw, 52px);
		line-height: 1.08; letter-spacing: -.015em; text-wrap: balance;
	}
	.w-date { margin: 0; font-size: 14px; color: var(--muted); }
	.w-draft {
		margin-left: 10px; font-style: normal; font-size: 12px; color: var(--vermilion);
		border: 1px solid currentColor; padding: 1px 8px; border-radius: 99px;
	}
	.w-lead { margin: 26px 0 0; font-size: 20px; line-height: 1.6; color: #c2cdc5; }
	.w-facts {
		display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px 28px;
		margin: 34px 0 0; padding: 20px 0; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft);
	}
	.w-facts dt { font-size: 12px; color: var(--muted); }
	.w-facts dd { margin: 2px 0 0; font-size: 15px; }
</style>

<style is:global>
	/* Markdown output does not carry Astro's scoped attributes, so these rules are global
	   but limited to the .prose wrapper. */
	.prose { margin-top: 44px; }
	.prose > * + * { margin-top: 1.1em; }
	.prose h2 { margin: 2.2em 0 0; font-weight: 500; font-size: 26px; line-height: 1.25; }
	.prose h3 { margin: 1.8em 0 0; font-weight: 500; font-size: 20px; line-height: 1.3; }
	.prose p, .prose ul, .prose ol { margin-bottom: 0; }
	.prose ul, .prose ol { padding-left: 1.3em; }
	.prose li + li { margin-top: .35em; }
	.prose strong { font-weight: 500; color: #fff; }
	.prose a { color: var(--bone); text-decoration: none; border-bottom: 1px solid var(--vermilion); }
	.prose a:hover { color: #fff; }
	.prose blockquote {
		margin-left: 0; padding: 4px 0 4px 20px; border-left: 2px solid var(--vermilion); color: var(--bone-dim);
	}
	.prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.5em 0; }
	.prose img { max-width: 100%; height: auto; border: 1px solid var(--line-soft); }
	.prose code {
		font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: .86em;
	}
	.prose :not(pre) > code {
		padding: .12em .4em; border-radius: 4px; background: rgba(223, 231, 224, .08);
	}
	.prose pre {
		/* !important overrides the background colour the code highlighter writes inline */
		background-color: #0b1014 !important; border: 1px solid var(--line-soft); border-radius: 6px;
		padding: 18px 20px; overflow-x: auto; font-size: 14px; line-height: 1.6;
	}
	.prose table {
		display: block; overflow-x: auto; border-collapse: collapse; font-size: 14px; max-width: 100%;
	}
	.prose th, .prose td { padding: 9px 14px; border-bottom: 1px solid var(--line-soft); text-align: left; vertical-align: top; }
	.prose th { font-weight: 500; color: var(--bone-dim); border-bottom-color: var(--line); }
</style>
