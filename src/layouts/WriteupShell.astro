---
// Shared frame for the writeup list and every writeup page.
// Same colors and font as the home page, but no 3D scene, so long reads stay fast.
import { PredictiveArcCanvas } from '@designcodeio/threeui';
import '@designcodeio/threeui/style.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://w3.org' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2305070a'/%3E%3Ccircle cx='16' cy='17' r='8' fill='%23e0231c'/%3E%3Crect x='4' y='8' width='24' height='2.6' fill='%23dfe7e0'/%3E%3Crect x='7' y='13' width='18' height='2' fill='%23dfe7e0'/%3E%3C/svg%3E" />
  <link rel="stylesheet" href="/secret-pathways-assets/fonts.css" />
  
  <style is:global>
    :root {
      --ink: #05070a;
      --bone: #dfe7e0;
      --bone-dim: #aab4ad;
      --muted: #78837c;
      --line: rgba(223, 231, 224, .13);
      --line-soft: rgba(223, 231, 224, .07);
      --vermilion: #e0231c;
      --pad: clamp(20px, 5vw, 56px);
      --measure: 68ch;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
	-webkit-text-size-adjust: 100%;
	background-color: var(--ink); /* Move background color here */
	}

	body {
	margin: 0;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	color: var(--bone);
	background-color: transparent; /* Make body transparent so canvas shows through */
	background-image: radial-gradient(70vw 45vh at 85% -12%, rgba(224, 35, 28, .10), transparent 70%);
	background-attachment: fixed;
	font-family: 'Onest', system-ui, -apple-system, 'Segoe UI', sans-serif;
	font-weight: 300;
	font-size: 17px;
	line-height: 1.72;
	-webkit-font-smoothing: antialiased;
	}


    a {
      color: inherit;
    }

    a:focus-visible {
      outline: 2px solid var(--vermilion);
      outline-offset: 3px;
    }

    .w-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 26px var(--pad);
      border-bottom: 1px solid var(--line-soft);
    }

    .w-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      font-weight: 500;
      letter-spacing: .02em;
    }

    .w-brand svg {
      width: 28px;
      height: 28px;
    }

    .w-bar nav {
      display: flex;
      gap: 22px;
      font-size: 14px;
    }

    .w-bar nav a {
      text-decoration: none;
      color: var(--bone-dim);
      transition: color .3s;
    }

    .w-bar nav a:hover {
      color: var(--bone);
    }

    /* Target the container frame for the halftone flow shader canvas */
	.shader-frame {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	width: 100%;
	height: 100vh;
	overflow: hidden;
	z-index: -1;
	pointer-events: none; /* Prevents the canvas from blocking text highlights or links */
	opacity: 0.22;        /* Dims down the template into a subtle background pattern */
	}

	/* Ensure the underlying canvas properly stretches to cover the frame */
	.shader-frame > canvas {
	position: absolute;
	inset: 0;
	display: block;
	width: 100% !important;
	height: 100% !important;
	object-fit: cover;
	}

    .w-arc {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      min-height: 100vh;
      z-index: -1;
      pointer-events: none;
      opacity: .8;
      mask-image: linear-gradient(#000 45%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
      .w-arc {
        display: none;
      }
    }

    .w-main {
      position: relative;
      isolation: isolate;
      flex: 1;
      padding: clamp(48px, 9vh, 110px) var(--pad) clamp(60px, 10vh, 120px);
    }

    .w-wrap {
      max-width: var(--measure);
      margin: 0 auto;
    }

    .w-foot {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      padding: 28px var(--pad);
      border-top: 1px solid var(--line-soft);
      font-size: 13px;
      color: var(--muted);
    }

    .w-foot a {
      color: var(--bone-dim);
      text-decoration: none;
    }

    .w-foot a:hover {
      color: var(--bone);
    }
  </style>
  <slot name="head" />
</head>
<body>
  <!-- Updated background container class and added correct template variant parameters -->
  <div class="shader-frame">
    <PredictiveArcCanvas 
      client:load 
      variant="halftone-flow" 
      hue={0} 
      saturation={1.00} 
      brightness={1.00} 
    />
  </div>

  <header class="w-bar">
    <a class="w-brand" href="/">
      <svg viewBox="0 0 44 44" fill="none" aria-hidden="true">
        <circle cx="22" cy="25" r="8.6" fill="#e0231c" fill-opacity=".9" />
        <path d="M5 13h34M9 18.4h26M22 8.5v27" stroke="#dfe7e0" stroke-width="1.5" />
      </svg>
      Jaspreet Singh
    </a>
    <nav>
      <a href="/writeups/">Writeups</a>
      <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </header>

  <main class="w-main">
    <div class="w-wrap">
      <slot />
    </div>
  </main>

  <footer class="w-foot">
    <span>© 2026 Jaspreet Singh</span>
    <a href="/">Back to the home page</a>
  </footer>
</body>
</html>
